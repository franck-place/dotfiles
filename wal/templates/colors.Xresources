! Generated by pywal. Merged via `xrdb -merge` by ~/.local/bin/apply-theme.
! Feeds both st (st-0.9, xresources patch) and dwm (xrdb patch) from the
! same palette -- see the color-role mapping in dwm's config.h/loadxrdb()
! and st's config.h resources[].

st.color0:             {color0}
st.color1:             {color1}
st.color2:             {color2}
st.color3:             {color3}
st.color4:             {color4}
st.color5:             {color5}
st.color6:             {color6}
st.color7:             {color7}
st.color8:             {color8}
st.color9:             {color9}
st.color10:            {color10}
st.color11:            {color11}
st.color12:            {color12}
st.color13:            {color13}
st.color14:            {color14}
st.color15:            {color15}
st.foreground:         {foreground}
st.background:         {background}
st.cursorColor:        {cursor}
st.cursorColorReverse: {background}

dwm.normbgcolor:       {background}
dwm.normfgcolor:       {foreground}
dwm.normbordercolor:   {color8}
dwm.selbgcolor:        {color4}
dwm.selbordercolor:    {color4}
dwm.selfgcolor:        {background}

! not palette-derived -- just announces the theme name so dwm's
! XcursorLibraryLoadCursor() and any Xcursor-aware app picks it up.
! ~/.local/bin/pywal-cursor-theme regenerates that theme's actual files
! from the same palette. Fixed name, always merged -- harmless even
! before the theme's ever been picked in Settings, since libXcursor just
! falls back to its own default if "pywal" isn't installed yet.
!
! Xcursor.size matters just as much: without it, apps that resolve the
! cursor straight from Xresources (bypassing gsettings entirely, which
! is most non-GTK X11/Xcursor consumers) fell back to whatever size
! they felt like -- ended up picking a 64px variant from this theme
! instead of a normal ~24px one. Matches gsettings' own default
! (org.gnome.desktop.interface cursor-size) so both paths agree.
Xcursor.theme: pywal
Xcursor.size: 24
