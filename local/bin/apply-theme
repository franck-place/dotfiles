#!/bin/sh
# Regenerate the pywal palette from a wallpaper and push it live into
# dwm (xrdb patch), st (xresources patch), Quickshell (Theme.qml watches
# ~/.cache/wal/colors.json directly, no action needed here), picom
# (shadow-color), GTK4 (mostly template-driven, see ~/.config/gtk-4.0/
# gtk.css, plus a libadwaita accent-color step below), and Qt/qt5ct+qt6ct.
#
# $1 = path to the wallpaper image. pywal sets the desktop wallpaper
# itself (it drives feh), so nothing else here needs to touch it.
set -e

img="$1"
[ -n "$img" ] || { echo "usage: apply-theme <image>" >&2; exit 1; }

# Absolute path: this script is invoked by quickshell (systemd --user
# unit), whose PATH is just /usr/local/{s,}bin:/usr/{s,}bin -- it doesn't
# include ~/.local/bin, where pipx installs wal.
#
# colorthief backend: the default ImageMagick-based "wal" backend rejects
# any image over 8000x8000px (system-wide IM policy at /etc/IM-7/policy.xml,
# left untouched on purpose) -- several of the wallpapers here exceed that.
#
# -s: skip pywal's own terminal-sequence injection. Without it, wal writes
# raw OSC escape codes (including OSC 708, a URxvt-only "border color"
# extension) directly into every open /dev/pts/* device on every run --
# that's what was actually crashing terminals, not the xrdb/SIGUSR1 path.
# Already-open st windows get recolored through our own controlled
# SIGUSR1 reload below instead; new ones read Xresources at their own
# startup.
"$HOME/.local/bin/wal" -i "$img" -q -s --backend colorthief
xrdb -merge "$HOME/.cache/wal/colors.Xresources"
pkill -USR1 -x st 2>/dev/null || true
xdotool key --clearmodifiers super+F5

# picom isn't pywal-templated (it's a static conf, not rendered from
# {colorN} placeholders) -- patch its shadow-color line in place and
# SIGUSR1 to hot-reload without restarting the compositor.
bg=$(jq -r '.special.background' "$HOME/.cache/wal/colors.json")
sed -i "s/^shadow-color = .*/shadow-color = \"$bg\";/" "$HOME/.config/picom.conf"
pkill -USR1 -x picom 2>/dev/null || true

# Qt (qt5ct/qt6ct) color scheme: also not expressible via a plain wal
# template -- {background} etc. render as bare "#rrggbb", but qt5ct's
# colors.conf format needs "#aarrggbb" (alpha-prefixed), a transform
# wal's {placeholder} substitution can't do -- so build it directly here,
# the same way picom's shadow-color line is patched above. Both
# ~/.config/qt5ct/qt5ct.conf and qt6ct.conf point at this one generated
# path already (set once, not regenerated); only its contents change.
# Field order verified against this system's own /usr/share/qt6ct/colors/
# schemes (21 comma-separated ARGB values under active/inactive/
# disabled_colors): WindowText, Button, Light, Midlight, Dark, Mid, Text,
# BrightText, ButtonText, Base, Window, Shadow, Highlight,
# HighlightedText, Link, LinkVisited, AlternateBase, (unused), ToolTipBase,
# ToolTipText, PlaceholderText.
argb() { printf '#ff%s' "$(printf '%s' "$1" | tr -d '#')"; }
fg=$(jq -r '.special.foreground' "$HOME/.cache/wal/colors.json")
c0=$(jq -r '.colors.color0' "$HOME/.cache/wal/colors.json")
c4=$(jq -r '.colors.color4' "$HOME/.cache/wal/colors.json")
c7=$(jq -r '.colors.color7' "$HOME/.cache/wal/colors.json")
c8=$(jq -r '.colors.color8' "$HOME/.cache/wal/colors.json")
BG=$(argb "$bg"); FG=$(argb "$fg"); C0=$(argb "$c0"); C4=$(argb "$c4"); C7=$(argb "$c7"); C8=$(argb "$c8")
cat > "$HOME/.cache/wal/qt-colorscheme.conf" << EOF
[ColorScheme]
active_colors=$FG, $C8, $C7, $C8, $C0, $C0, $FG, $FG, $FG, $BG, $BG, $C0, $C4, $BG, $C4, $C4, $BG, $BG, $BG, $FG, $C8
inactive_colors=$C8, $BG, $C8, $C8, $C0, $C0, $C8, $FG, $C8, $BG, $BG, $C0, $C8, $C8, $C8, $C8, $BG, $BG, $BG, $FG, $C8
disabled_colors=$C8, $BG, $C8, $C8, $C0, $C0, $C8, $FG, $C8, $BG, $BG, $C0, $BG, $C8, $C8, $C8, $BG, $BG, $BG, $FG, $C8
EOF

# GTK4/libadwaita's real, documented theming lever (GNOME 47+): a
# dark/light color-scheme switch plus one of a fixed 9-value accent-color
# enum (blue/teal/green/yellow/orange/red/pink/purple/slate) -- not
# arbitrary hex. gtk-colors.css above covers classic GTK4 widgets that
# don't use libadwaita's own styling; this covers the rest as well as
# it can:
#   - color-scheme from the background's relative luminance (so a light
#     wallpaper palette doesn't end up forced dark)
#   - accent-color snapped to the closest of the 9 presets by Euclidean
#     RGB distance against libadwaita's own reference hexes
#     (css-variables.html)
scheme=$(awk -v bg="$bg" '
BEGIN {
    r = strtonum("0x" substr(bg, 2, 2)) / 255
    g = strtonum("0x" substr(bg, 4, 2)) / 255
    b = strtonum("0x" substr(bg, 6, 2)) / 255
    lum = 0.2126 * r + 0.7152 * g + 0.0722 * b
    print (lum < 0.5) ? "prefer-dark" : "prefer-light"
}')
gsettings set org.gnome.desktop.interface color-scheme "$scheme"

gnome_accent=$(awk -v target="$c4" '
BEGIN {
    split("blue teal green yellow orange red pink purple slate", names, " ")
    split("3584e4 2190a4 3a944a c88800 ed5b00 e62d42 d56199 9141ac 6f8396", hexes, " ")
    tr = strtonum("0x" substr(target, 2, 2))
    tg = strtonum("0x" substr(target, 4, 2))
    tb = strtonum("0x" substr(target, 6, 2))
    bestd = -1
    for (i = 1; i <= 9; i++) {
        r = strtonum("0x" substr(hexes[i], 1, 2))
        g = strtonum("0x" substr(hexes[i], 3, 2))
        b = strtonum("0x" substr(hexes[i], 5, 2))
        d = (r - tr)^2 + (g - tg)^2 + (b - tb)^2
        if (bestd < 0 || d < bestd) { bestd = d; best = names[i] }
    }
    print best
}')
gsettings set org.gnome.desktop.interface accent-color "$gnome_accent"
