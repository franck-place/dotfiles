{ 
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "suse", // search for logos: fastfetch --list-logos or --print-logos
        "padding": {
	        "top": 1
	},
    },
    "display": {
        "separator": "  "
    },
    "modules": [
	"break",
        {
            "type": "os",
            "key": "OS  ",
            "keyColor": "36",  // = color1
        },
        {
            "type": "kernel",
            "key": "KERNEL ",
            "keyColor": "36",
        },
        {
            "type": "packages",
            "format": "{rpm} (rpm)",
            "key": "PACKAGES ",
            "keyColor": "36",  
        },
        {
            "type": "shell",
            "key": "SHELL  ",
            "keyColor": "36", 
        },
        {
            "type": "terminal",
            "key": "TERMINAL ",
            "keyColor": "36", 
        },
        {
            "type": "wm",
            "key": "WM  ",
            "keyColor": "36", 
        },
        "break",
    ]
}
